diff --git a/games/totk/android/java/com/aure/totk/setup/GameReport.java b/games/totk/android/java/com/aure/totk/setup/GameReport.java
new file mode 100644
index 0000000..fcf7598
--- /dev/null
+++ b/games/totk/android/java/com/aure/totk/setup/GameReport.java
@@ -0,0 +1,136 @@
+package com.aure.totk.setup;
+
+import android.app.ActivityManager;
+import android.app.ApplicationExitInfo;
+import android.content.Context;
+import android.os.Build;
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+/** About → Share game log (S23 fork): a plain-text report for a bug report, without root. It holds why Android ended
+ * the app's last processes (ApplicationExitInfo: low memory, native crash, killed...), the device and its memory, the
+ * menu's settings.env and the end of <game>/totk.log, the log of the last game session (the next game start
+ * overwrites it). No game files, keys or saves are read. */
+final class GameReport {
+    private GameReport() { }
+    /** The end of totk.log kept in the report: share sheets and chat apps refuse very long text. */
+    private static final int LOG_TAIL_BYTES = 24 * 1024;
+
+    static String build(Context context, String appVersion) {
+        StringBuilder out = new StringBuilder();
+        out.append("TotK Native game report\n");
+        out.append("App: ").append(appVersion).append('\n');
+        out.append("Device: ").append(Build.MANUFACTURER).append(' ').append(Build.MODEL).append(" (").append(Build.DEVICE)
+                .append("), SoC ").append(Build.SOC_MODEL).append(", Android ").append(Build.VERSION.RELEASE)
+                .append(" (API ").append(Build.VERSION.SDK_INT).append(")\n");
+        ActivityManager am = context.getSystemService(ActivityManager.class);
+        if (am != null) {
+            ActivityManager.MemoryInfo mem = new ActivityManager.MemoryInfo();
+            am.getMemoryInfo(mem);
+            out.append("Memory now: total ").append(mem.totalMem >> 20).append(" MiB, available ").append(mem.availMem >> 20)
+                    .append(" MiB, low-memory threshold ").append(mem.threshold >> 20).append(" MiB, low ").append(mem.lowMemory)
+                    .append('\n');
+            out.append("\n== Why Android ended the last processes (newest first) ==\n");
+            exits(out, am, context.getPackageName());
+        }
+        out.append("\n== settings.env ==\n");
+        out.append(tail(new File(context.getFilesDir(), "settings.env"), 8 * 1024));
+        File game;
+        try { game = StorageLocation.gameDir(context); } catch (RuntimeException failed) { game = null; }
+        File totkEnv = game == null ? null : new File(game, "totk.env");
+        if (totkEnv != null && totkEnv.isFile()) out.append("\n== totk.env (developer overrides) ==\n").append(tail(totkEnv, 8 * 1024));
+        /* A game start keeps the session before it as totk.prev.log when that one was long (frontend_android.c log_start):
+           after a crash and a quick restart, the report still shows the session that ended. */
+        File log = game == null ? null : new File(game, "totk.log");
+        File prev = game == null ? null : new File(game, "totk.prev.log");
+        String which = "the last game session";
+        if (log != null && prev.isFile() && (!log.isFile() || log.length() < 256 * 1024)) { log = prev; which = "the session before the last, short one"; }
+        if (log != null) out.append("\n== Memory lines from ").append(which).append(" (start and end) ==\n").append(memoryLines(log));
+        out.append("\n== ").append(log == null ? "totk.log" : log.getName()).append(" (last ").append(LOG_TAIL_BYTES / 1024)
+                .append(" KiB of ").append(which).append(") ==\n");
+        out.append(log == null ? "(game folder unknown)\n" : tail(log, LOG_TAIL_BYTES));
+        return out.toString();
+    }
+
+    private static void exits(StringBuilder out, ActivityManager am, String pkg) {
+        List<ApplicationExitInfo> list;
+        try { list = am.getHistoricalProcessExitReasons(pkg, 0, 6); }
+        catch (RuntimeException failed) { out.append("(not available: ").append(failed.getMessage()).append(")\n"); return; }
+        if (list.isEmpty()) { out.append("(none recorded)\n"); return; }
+        SimpleDateFormat time = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.ROOT);
+        for (ApplicationExitInfo e : list) {
+            out.append(time.format(new Date(e.getTimestamp()))).append("  ").append(e.getProcessName())
+                    .append("  reason ").append(reason(e.getReason())).append(" (").append(e.getReason()).append(')')
+                    .append(", status ").append(e.getStatus())
+                    .append(", importance ").append(e.getImportance())
+                    .append(", pss ").append(e.getPss() >> 10).append(" MiB, rss ").append(e.getRss() >> 10).append(" MiB");
+            if (e.getDescription() != null) out.append(", \"").append(e.getDescription()).append('"');
+            out.append('\n');
+        }
+    }
+    private static String reason(int r) {
+        switch (r) {
+            case ApplicationExitInfo.REASON_EXIT_SELF: return "EXIT_SELF";
+            case ApplicationExitInfo.REASON_SIGNALED: return "SIGNALED";
+            case ApplicationExitInfo.REASON_LOW_MEMORY: return "LOW_MEMORY";
+            case ApplicationExitInfo.REASON_CRASH: return "CRASH";
+            case ApplicationExitInfo.REASON_CRASH_NATIVE: return "CRASH_NATIVE";
+            case ApplicationExitInfo.REASON_ANR: return "ANR";
+            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE: return "INITIALIZATION_FAILURE";
+            case ApplicationExitInfo.REASON_PERMISSION_CHANGE: return "PERMISSION_CHANGE";
+            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE: return "EXCESSIVE_RESOURCE_USAGE";
+            case ApplicationExitInfo.REASON_USER_REQUESTED: return "USER_REQUESTED";
+            case ApplicationExitInfo.REASON_USER_STOPPED: return "USER_STOPPED";
+            case ApplicationExitInfo.REASON_DEPENDENCY_DIED: return "DEPENDENCY_DIED";
+            case ApplicationExitInfo.REASON_OTHER: return "OTHER";
+            case ApplicationExitInfo.REASON_FREEZER: return "FREEZER";
+            default: return "UNKNOWN";
+        }
+    }
+    /** The memory timeline from anywhere in the log (diagnostics): the first 20 lines (the start of the session, a
+     * baseline) and the last 100, so a short tail still has them. */
+    private static String memoryLines(File log) {
+        java.util.ArrayList<String> first = new java.util.ArrayList<>();
+        java.util.ArrayDeque<String> keep = new java.util.ArrayDeque<>();
+        long skipped = 0;
+        try (java.io.BufferedReader in = new java.io.BufferedReader(new java.io.FileReader(log))) {
+            for (String line; (line = in.readLine()) != null; ) {
+                if (line.contains("mark mem1") || line.contains("mark ram-saver") || line.contains("memory image blocks")
+                        || line.contains("memory: malloc") || line.contains("memory diag") || line.contains("mark smaps")
+                        || line.contains("mark meminfo") || line.contains(" fps over the last 300")
+                        || line.contains("memory pools-use") || line.contains("[pipe-keep]")
+                        || line.contains("memory pools-lazy") || line.contains("on-demand pool")) {
+                    if (first.size() < 20) { first.add(line); continue; }
+                    if (keep.size() == 100) { keep.removeFirst(); skipped++; }
+                    keep.addLast(line);
+                }
+            }
+        } catch (IOException missing) {
+            return "(" + missing.getMessage() + ")\n";
+        }
+        StringBuilder out = new StringBuilder();
+        for (String line : first) out.append(line).append('\n');
+        if (skipped > 0) out.append("(… ").append(skipped).append(" lines omitted)\n");
+        for (String line : keep) out.append(line).append('\n');
+        return first.isEmpty() ? "(none)\n" : out.toString();
+    }
+    /** The last max bytes of a file as text, starting at a line boundary. */
+    private static String tail(File file, int max) {
+        try (RandomAccessFile in = new RandomAccessFile(file, "r")) {
+            long length = in.length(), from = Math.max(0, length - max);
+            byte[] bytes = new byte[(int) (length - from)];
+            in.seek(from); in.readFully(bytes);
+            String text = new String(bytes, StandardCharsets.UTF_8);
+            if (from > 0) { int nl = text.indexOf('\n'); if (nl >= 0) text = text.substring(nl + 1); }
+            return (from > 0 ? "(… " + (from >> 10) + " KiB earlier omitted)\n" : "") + text + (text.endsWith("\n") ? "" : "\n");
+        } catch (IOException missing) {
+            return "(" + file.getName() + ": " + missing.getMessage() + ")\n";
+        }
+    }
+}
