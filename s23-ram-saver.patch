+/** RAM saver (S23 fork), game process side. When the menu's RAM saver is On or Max (TOTK_RAM_SAVER in settings.env),
+ * a low-priority thread checks the system's free memory every 2 s. When it falls near Android's low-memory threshold,
+ * it asks the running game, through the live switch file <game>/totk.ctl (runtime/live_ctl.h), to keep only 8 MiB of
+ * texture-upload staging per slot; when memory has been comfortable again for 30 s it returns to the launch value.
+ * Android 14+ no longer sends onTrimMemory "running low" levels to a foreground app, so this polls instead.
+ * The switch takes effect at the next presented frame, so nothing happens while the game is paused. */
+final class RamGuard {
+    private static final String TAG = "TotkRamGuard";
+    private static final long MIB = 1L << 20, PERIOD_MS = 2000, CALM_MS = 30_000;
+
+    private final ActivityManager am;
+    private final File ctl;
+    private final long margin;
+    private final HandlerThread thread = new HandlerThread("totk-ramguard", Process.THREAD_PRIORITY_BACKGROUND);
+    private final Handler handler;
+    private final ActivityManager.MemoryInfo info = new ActivityManager.MemoryInfo();
+    private boolean trimmed;
+    private int ticks;
+    private long calmSince;
+    private volatile boolean closed;
+
+    private RamGuard(Context context, File gameDir, String mode) {
+        am = context.getSystemService(ActivityManager.class);
+        ctl = new File(gameDir, "totk.ctl");
+        margin = ("max".equals(mode) ? 1024 : 512) * MIB;
+        thread.start();
+        handler = new Handler(thread.getLooper());
+        handler.postDelayed(this::check, PERIOD_MS);
+        Log.i(TAG, "RAM saver " + mode + ": watching free memory (margin " + margin / MIB + " MiB), live file " + ctl);
+    }
+
+    /** Starts the watcher when settings.env (in the app's private files folder) turns the RAM saver on, else null. */
+    static RamGuard start(Context context) {
+        String mode = mode(new File(context.getFilesDir(), "settings.env"));
+        if (mode == null) return null;
+        try {
+            File game = com.aure.totk.setup.StorageLocation.gameDir(context);
+            return new RamGuard(context, game, mode);
+        } catch (RuntimeException failed) {
+            Log.w(TAG, "RAM saver watcher not started", failed);
+            return null;
+        }
+    }
+    private static String mode(File env) {
+        try (BufferedReader in = new BufferedReader(new FileReader(env))) {
+            String mode = null;
+            for (String line; (line = in.readLine()) != null; )
+                if (line.startsWith("TOTK_RAM_SAVER=")) mode = line.substring(15).trim();
+            return "on".equals(mode) || "max".equals(mode) ? mode : null;
+        } catch (IOException missing) {
+            return null;
+        }
+    }
+
+    private void check() {
+        if (closed) return;
+        try {
+            am.getMemoryInfo(info);
+            long now = android.os.SystemClock.uptimeMillis();
+            boolean tight = info.lowMemory || info.availMem < info.threshold + margin;
+            boolean comfortable = info.availMem > info.threshold + 2 * margin;
+            if (tight && !trimmed) {
+                if (write("mark ram-saver: free " + info.availMem / MIB + " MiB, threshold " + info.threshold / MIB
+                        + " MiB, low " + info.lowMemory + "\nset TOTK_VK_STAGING_RETAIN_MB=8\n")) {
+                    trimmed = true;
+                    Log.i(TAG, "free RAM " + info.availMem / MIB + " MiB (threshold " + info.threshold / MIB + "): staging trimmed");
+                }
+                calmSince = 0;
+            } else if (trimmed) {
+                if (!comfortable) calmSince = 0;
+                else if (calmSince == 0) calmSince = now;
+                else if (now - calmSince >= CALM_MS && write("mark ram-saver: free " + info.availMem / MIB
+                        + " MiB again\nunset TOTK_VK_STAGING_RETAIN_MB\n")) {
+                    trimmed = false; calmSince = 0;
+                    Log.i(TAG, "free RAM " + info.availMem / MIB + " MiB: staging back to its launch value");
+                }
+            }
+        } catch (RuntimeException failed) {
+            Log.w(TAG, "memory check failed", failed);
+        }
+        // Every 30 s, where the memory goes (two lines: totk.ctl takes at most 240 characters per line).
+        if (++ticks % 15 == 0) {
+            try { write("mark mem1: " + memLine() + "\nmark mem2: " + gpuLine() + "\n"); }
+            catch (RuntimeException failed) { Log.w(TAG, "memory snapshot failed", failed); }
+        }
+        if (!closed) handler.postDelayed(this::check, PERIOD_MS);
+    }
+
+    /** System free memory and this process's resident memory by kind, MiB (/proc/self/status: kB). */
+    private String memLine() {
+        StringBuilder out = new StringBuilder();
+        out.append("avail=").append(info.availMem / MIB).append(" thr=").append(info.threshold / MIB);
+        for (String line : lines("/proc/self/status", 64)) {
+            for (String key : new String[]{"VmRSS", "RssAnon", "RssFile", "RssShmem", "VmSwap"}) {
+                if (line.startsWith(key + ":")) {
+                    String kb = line.substring(key.length() + 1).trim().split("\\s+")[0];
+                    try { out.append(' ').append(key).append('=').append(Long.parseLong(kb) >> 10); }
+                    catch (NumberFormatException ignored) { }
+                }
+            }
+        }
+        return out.toString();
+    }
+    /** GPU (KGSL) allocations of this process, MiB, and memory pressure (PSI avg10), where the device exposes them. */
+    private String gpuLine() {
+        StringBuilder out = new StringBuilder("kgsl");
+        String dir = "/sys/class/kgsl/kgsl/proc/" + Process.myPid() + "/";
+        for (String name : new String[]{"kernel", "gpumem_mapped", "imported_mem"}) {
+            List<String> v = lines(dir + name, 1);
+            out.append(' ').append(name).append('=');
+            try { out.append(v.isEmpty() ? "-" : String.valueOf(Long.parseLong(v.get(0).trim()) / MIB)); }
+            catch (NumberFormatException bad) { out.append('?'); }
+        }
+        for (String line : lines("/proc/pressure/memory", 2)) {
+            int at = line.indexOf("avg10=");
+            if (at >= 0) out.append(" psi-").append(line.substring(0, line.indexOf(' '))).append('=')
+                    .append(line.substring(at + 6, line.indexOf(' ', at) < 0 ? line.length() : line.indexOf(' ', at)));
+        }
+        return out.toString();
+    }
+    private static List<String> lines(String path, int max) {
+        List<String> out = new ArrayList<>();
+        try (BufferedReader in = new BufferedReader(new FileReader(path))) {
+            for (String line; out.size() < max && (line = in.readLine()) != null; ) out.add(line);
+        } catch (IOException | SecurityException unavailable) { }
+        return out;
+    }
+    /** Appends one complete line (one write) to totk.ctl; the game's reader stages only appended complete lines. */
+    private boolean write(String line) {
+        try (FileOutputStream out = new FileOutputStream(ctl, true)) {
+            out.write(line.getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException | SecurityException failed) {
+            Log.w(TAG, "could not write " + ctl, failed);
+            return false;
+        }
+    }
+    void close() {
+        closed = true;
+        handler.removeCallbacksAndMessages(null);
+        thread.quitSafely();
+    }
+}
